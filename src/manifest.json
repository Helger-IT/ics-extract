{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.0.0",
  "author": "Philip Helger",
  "homepage_url": "https://github.com/Helger-IT/ics-extract",
  "browser_specific_settings": {
    "gecko": {
      "id": "ics-extract@helger.com",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "settings.js",
      "ics.js",
      "background.js"
    ]
  },
  "message_display_action": {
    "type": "menu",
    "default_title": "__MSG_actionTitle__",
    "default_icon": "images/calendar-dark.svg",
    "theme_icons": [
      {
        "light": "images/calendar-light.svg",
        "dark": "images/calendar-dark.svg",
        "size": 16
      },
      {
        "light": "images/calendar-light.svg",
        "dark": "images/calendar-dark.svg",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "permissions": [
    "messagesRead",
    "downloads",
    "downloads.open",
    "menus",
    "storage"
  ],
  "icons": {
    "16": "images/calendar-dark.svg",
    "32": "images/calendar-dark.svg",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  }
}
